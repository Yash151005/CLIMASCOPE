# Set to false to use the FastAPI backend instead of simulated frontend handlers.
VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1

# Backend defaults to local SQLite. Docker Compose overrides this with PostGIS.
DATABASE_URL=sqlite:///./climascope.db
ENVIRONMENT=development
DEBUG=false
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local-only Docker Compose database password; replace for shared deployments.
POSTGRES_PASSWORD=climascope_local
